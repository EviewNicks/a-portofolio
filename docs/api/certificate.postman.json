              "    pm.expect(jsonData.data).to.have.property('certificate_image');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "progress",
              "value": "100",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "New certificate image (optional for update)"
            },
            {
              "key": "secret",
              "value": "{{ADMIN_SECRET}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{BASE_URL}}/api/certificates/{{COURSE_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "certificates", "{{COURSE_ID}}"]
        },
        "description": "Update certificate (FormData, UUID only, file optional)"
      },
      "response": []
    },
    {
      "name": "6. Delete Certificate (Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/api/certificates/{{COURSE_ID}}?secret={{ADMIN_SECRET}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "certificates", "{{COURSE_ID}}"],
          "query": [
            {
              "key": "secret",
              "value": "{{ADMIN_SECRET}}"
            }
          ]
        },
        "description": "Soft delete certificate by ID (admin only)"
      },
      "response": []

{
  "info": {
    "name": "Certificate API",
    "description": "API testing untuk Certificate Management System - FormData Only",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "ADMIN_SECRET",
      "value": "your-secret-key-here",
      "type": "string"
    },
    {
      "key": "COURSE_ID",
      "value": "",
      "type": "string"
    },
    {
      "key": "COURSE_SLUG",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get All Certificates (Public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has data array', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('data');",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/api/certificates",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "certificates"]
        },
        "description": "Get all non-deleted certificates (public access)"
      },
      "response": []
    },
    {
      "name": "2. Create Certificate with Image (Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has course data', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('data');",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.expect(jsonData.data).to.have.property('slug');",
              "    pm.expect(jsonData.data).to.have.property('certificate_image');",
              "    ",
              "    // Save for next requests",
              "    pm.collectionVariables.set('COURSE_ID', jsonData.data.id);",
              "    pm.collectionVariables.set('COURSE_SLUG', jsonData.data.slug);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Advanced TypeScript",
              "type": "text"
            },
            {
              "key": "organisation",
              "value": "Frontend Masters",
              "type": "text"
            },
            {
              "key": "issue_date",
              "value": "2024-01-15",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Deep dive into TypeScript advanced concepts",
              "type": "text"
            },
            {
              "key": "progress",
              "value": "100",
              "type": "text"
            },
            {
              "key": "platform",
              "value": "Frontend Masters",
              "type": "text"
            },
            {
              "key": "url",
              "value": "https://frontendmasters.com/courses/advanced-typescript",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "Certificate image (REQUIRED)"
            },
            {
              "key": "secret",
              "value": "{{ADMIN_SECRET}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{BASE_URL}}/api/certificates",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "certificates"]
        },
        "description": "Create certificate with image upload (FormData, file required)"
      },
      "response": []
    },

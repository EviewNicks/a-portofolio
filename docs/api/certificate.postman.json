    {
      "name": "4. Get Certificate by Slug (Public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has course data with slug', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('slug');",
              "    pm.expect(jsonData.data.slug).to.equal(pm.collectionVariables.get('COURSE_SLUG'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/api/certificates/{{COURSE_SLUG}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "certificates", "{{COURSE_SLUG}}"]
        },
        "description": "Get certificate by slug (endpoint accepts both UUID and slug)"
      },
      "response": []
    },
    {
      "name": "5. Update Certificate with New Image (Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
